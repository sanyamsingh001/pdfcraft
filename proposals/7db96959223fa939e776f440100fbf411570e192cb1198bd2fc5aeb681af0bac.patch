+fn reset_buttons_distinguish_omitted_and_explicit_empty_field_lists() {
+    let mut doc = fixture();
+    let go = field(&fields(&doc), "go").obj;
+    let empty_array = doc.add(Object::Array(Vec::new()));
+    for target in [None, Some(Object::Array(Vec::new())), Some(Object::Ref(empty_array))] {
+        for exclude in [false, true] {
+            let mut action = Dict::new();
+            action.set(b"S".to_vec(), Object::name("ResetForm"));
+            action.set(b"Flags".to_vec(), Object::Int(i64::from(exclude)));
+            if let Some(target) = &target {
+                action.set(b"Fields".to_vec(), target.clone());
+            }
+            doc.update_dict(go, |d| d.set(b"A".to_vec(), Object::Dict(action))).unwrap();
+            let all = Some(af::ButtonAction::Reset { fields: Vec::new(), exclude });
+            let parsed = field(&fields(&doc), "go").button.clone();
+            if target.is_some() && !exclude {
+                assert_eq!(parsed, Some(af::ButtonAction::ResetNone), "an empty inclusion selects no fields");
+            } else {
+                assert_eq!(parsed, all, "omission and empty exclusion still reset all");
+            }
+            assert_eq!(field(&fields(&reopen(&doc)), "go").button, parsed);
+        }
+    }
+}
