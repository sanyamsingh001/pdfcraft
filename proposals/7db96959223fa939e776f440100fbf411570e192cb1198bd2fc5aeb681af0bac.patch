+#[test]
+fn empty_reset_action_roundtrips_through_tools_without_changing_reset_all() {
+    let dir = workdir("empty-reset-actions");
+    let saved_action = |path: &Path| {
+        let bytes = std::sync::Arc::new(std::fs::read(path).unwrap());
+        let cos = pdfcraft_cos::Document::open(bytes.clone()).unwrap();
+        let mut session = pdfcraft_engine::Session::new();
+        let id = session.open("saved.pdf", None, bytes, None).unwrap();
+        let field = session.get(id).unwrap().form.iter().find(|field| field.name == "Go").unwrap().obj;
+        let widget = cos.get(field);
+        cos.resolve(widget.as_dict().unwrap().get(b"A").unwrap()).as_dict().unwrap().clone()
+    };
+    let mut a = auto(&dir);
+    let doc = ok(&mut a, "doc_open", json!({ "path": "a.pdf" }))["doc"].as_u64().unwrap();
+    ok(&mut a, "form_add_field", json!({ "doc": doc, "page": 1, "type": "button", "rect": [20, 20, 120, 42], "name": "Go" }));
+    let selected = json!([{ "trigger": "mouse_up", "reset_none": true }]);
+    let actions = ok(&mut a, "form_set_actions", json!({ "doc": doc, "field": "Go", "actions": selected }))["actions"].clone();
+    assert_eq!(actions, selected);
+    let read = ok(&mut a, "form_actions", json!({ "doc": doc, "field": "Go" }));
+    ok(&mut a, "form_set_actions", json!({ "doc": doc, "field": "Go", "actions": read["actions"] }));
+    ok(&mut a, "doc_save", json!({ "doc": doc, "path": "no-fields.pdf" }));
+    let action = saved_action(&dir.join("no-fields.pdf"));
+    assert!(action.get(b"Fields").unwrap().as_array().unwrap().is_empty());
+    let reopened = ok(&mut a, "doc_open", json!({ "path": "no-fields.pdf" }))["doc"].as_u64().unwrap();
+    assert_eq!(ok(&mut a, "form_actions", json!({ "doc": reopened, "field": "Go" }))["actions"], selected);
+    for invalid in [json!([{ "trigger": "mouse_up", "reset_none": false }]), json!([{ "trigger": "mouse_up", "reset_none": true, "reset": [] }])] {
+        assert!(a.call("form_set_actions", &json!({ "doc": reopened, "field": "Go", "actions": invalid })).is_err());
+    }
+    let all = json!([{ "trigger": "mouse_up", "reset": [] }]);
+    assert_eq!(ok(&mut a, "form_set_actions", json!({ "doc": reopened, "field": "Go", "actions": all }))["actions"], all);
+    ok(&mut a, "doc_save", json!({ "doc": reopened, "path": "all-fields.pdf" }));
+    let action = saved_action(&dir.join("all-fields.pdf"));
+    assert!(!action.contains(b"Fields"));
+}
