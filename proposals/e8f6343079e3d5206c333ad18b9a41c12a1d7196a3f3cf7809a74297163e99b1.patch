+fn wait_for_recovery_state(h: &mut Harness<'static, PdfCraftApp>, description: &str, ready: impl Fn(&PdfCraftApp) -> bool) {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    loop {
+        let app = h.state();
+        assert!(
+            app.toast.as_ref().is_none_or(|toast| {
+                !toast.0.starts_with("Couldn't recover") && !toast.0.starts_with("Couldn't open") && !toast.0.starts_with("Couldn't read")
+            }),
+            "{description} failed: {:?}",
+            app.toast
+        );
+        assert!(app.password_prompt.as_ref().is_none_or(|prompt| prompt.error.is_none()), "{description}: password was rejected");
+        if ready(app) {
+            return;
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "{description} timed out: active {:?}, tabs {}, password prompt {}, dialog {:?}",
+            app.active,
+            app.views.len(),
+            app.password_prompt.is_some(),
+            app.dialog
+        );
+        h.run_steps(1);
+        std::thread::yield_now();
+    }
+}
+
+fn active_document_named(app: &PdfCraftApp, name: &str) -> bool {
+    app.active.and_then(|index| app.views.get(index)).and_then(|view| app.session.get(view.id)).is_some_and(|doc| doc.name == name)
+}
