+    assert_eq!(parsed.skipped, 0);
+    let matrix = parsed.ops.iter().find(|op| op.is("cm")).unwrap().nums::<6>().unwrap();
+    let rect = parsed.ops.iter().find(|op| op.is("re")).unwrap().nums::<4>().unwrap();
