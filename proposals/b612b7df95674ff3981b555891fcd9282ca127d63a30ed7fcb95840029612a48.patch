+#[cfg(not(target_arch = "wasm32"))]
+fn wait_for_link_state(h: &mut Harness<'static, PdfCraftApp>, description: &str, ready: impl Fn(&PdfCraftApp) -> bool) {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    while !ready(h.state()) {
+        let app = h.state();
+        let active_path = app.active.and_then(|i| app.views.get(i)).and_then(|v| app.session.get(v.id)).and_then(|d| d.path.as_deref());
+        assert!(
+            std::time::Instant::now() < deadline,
+            "{description}: active path {active_path:?}, tabs {}, password prompt {:?}, toast {:?}",
+            app.views.len(),
+            app.password_prompt.as_ref().map(|p| (&p.path, &p.error)),
+            app.toast
+        );
+        h.run_steps(1);
+        std::thread::yield_now();
+    }
+}
