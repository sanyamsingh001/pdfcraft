+/// Original one-page 200x300 pt PDF, with direct or indirect viewer preferences and value.
+fn print_scaling_fixture(scaling: Option<&str>, indirect: bool) -> Vec<u8> {
+    let entry = scaling.map(|name| if indirect { "/PrintScaling 6 0 R".into() } else { format!("/PrintScaling /{name}") }).unwrap_or_default();
+    let preferences =
+        scaling.map(|_| if indirect { "/ViewerPreferences 5 0 R".into() } else { format!("/ViewerPreferences << {entry} >>") }).unwrap_or_default();
+    let content = "0 0 0 rg 20 30 40 50 re f";
+    let objects = [
+        format!("<< /Type /Catalog /Pages 2 0 R {preferences} >>"),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 /MediaBox [0 0 200 300] >>".into(),
+        "<< /Type /Page /Parent 2 0 R /Resources << >> /Contents 4 0 R >>".into(),
+        format!("<< /Length {} >>\nstream\n{content}\nendstream", content.len()),
+        format!("<< {entry} >>"),
+        format!("/{}", scaling.unwrap_or("AppDefault")),
+    ];
+    let mut bytes = b"%PDF-1.7\n".to_vec();
+    let mut offsets = Vec::new();
+    for (i, object) in objects.iter().enumerate() {
+        offsets.push(bytes.len());
+        bytes.extend_from_slice(format!("{} 0 obj\n{object}\nendobj\n", i + 1).as_bytes());
+    }
+    let xref = bytes.len();
+    bytes.extend_from_slice(format!("xref\n0 {}\n0000000000 65535 f \n", objects.len() + 1).as_bytes());
+    for offset in offsets {
+        bytes.extend_from_slice(format!("{offset:010} 00000 n \n").as_bytes());
+    }
+    bytes.extend_from_slice(format!("trailer << /Size {} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n", objects.len() + 1).as_bytes());
+    bytes
+}
+
+fn printed_placement(bytes: Vec<u8>) -> [f64; 6] {
+    let doc = pdfcraft_cos::Document::open(std::sync::Arc::new(bytes)).unwrap();
+    let pages = pdfcraft_model::pages(&doc);
+    assert_eq!(pages.len(), 1);
+    let contents = doc.resolve(pages[0].dict.get(b"Contents").unwrap());
+    let pdfcraft_cos::Object::Stream(stream) = contents.as_ref() else { panic!("print sheet content stream") };
+    let text = String::from_utf8(stream.decoded().unwrap()).unwrap();
+    let words: Vec<_> = text.split_whitespace().collect();
+    let matrix = words.windows(7).find(|words| words[6] == "cm").unwrap();
+    std::array::from_fn(|i| matrix[i].parse().unwrap())
+}
+
+fn assert_printed_placement(actual: [f64; 6], expected: [f64; 6]) {
+    for (actual, expected) in actual.into_iter().zip(expected) {
+        assert!((actual - expected).abs() < 0.0001, "print placement: {actual} != {expected}");
+    }
+}
+
+fn scaling_harness() -> Harness<'static, PdfCraftApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(1400.0, 1000.0)).build_eframe(|_| {
+        let mut app = PdfCraftApp::new();
+        app.set_option("language", "en").unwrap();
+        app.printer_source = Some(std::sync::Arc::new(|| Vec::new()));
+        app.open_bytes("none.pdf", None, print_scaling_fixture(Some("None"), true)).unwrap();
+        app.open_bytes("default.pdf", None, print_scaling_fixture(None, false)).unwrap();
+        app.active = Some(0);
+        app
+    });
+    h.run_steps(4);
+    assert_eq!(h.state().views.len(), 2);
+    h
+}
+
+fn open_scaling_print(h: &mut Harness<'static, PdfCraftApp>) {
+    assert!(h.state_mut().execute("print.dialog"));
+    h.run_steps(3);
+    assert_eq!(h.state().dialog, Some(Dialog::Print));
+}
+
+fn cancel_scaling_print(h: &mut Harness<'static, PdfCraftApp>) {
+    h.get_by_label("Cancel").click();
+    h.run_steps(2);
+    assert_eq!(h.state().dialog, None);
+}
+
+#[test]
+fn print_scaling_none_reinitializes_and_does_not_leak_into_another_document() {
+    use pdfcraft_engine::print::{Layout, SizeMode};
+    let mut h = scaling_harness();
+    let id = h.state().views[0].id;
+    let before = h.state().session.get(id).unwrap().bytes.clone();
+    open_scaling_print(&mut h);
+    assert_eq!(h.state().print_draft.size, SizeMode::Actual);
+    h.get_by_label("Fit").click();
+    h.run_steps(2);
+    assert_eq!(h.state().print_draft.settings(1, &[]).unwrap().layout, Layout::Size(SizeMode::Fit));
+    cancel_scaling_print(&mut h);
+    open_scaling_print(&mut h);
+    assert_eq!(h.state().print_draft.size, SizeMode::Actual, "each displayed dialog reads the current document preset");
+    cancel_scaling_print(&mut h);
+    h.get_by_label("default.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    assert_eq!(h.state().print_draft.size, SizeMode::Fit, "automatic Actual is not the manual app default");
+    cancel_scaling_print(&mut h);
+    h.get_by_label("none.pdf").click();
+    h.run_steps(2);
+    assert_eq!(h.state().session.get(id).unwrap().bytes, before, "dialog initialization and manual choices do not edit the PDF");
+    // Replace this same DocId's contents: the next dialog must read the replacement, not a cache.
+    h.state_mut().session.reload(id, std::sync::Arc::new(print_scaling_fixture(Some("AppDefault"), false))).unwrap();
+    open_scaling_print(&mut h);
+    assert_eq!(h.state().print_draft.size, SizeMode::Fit);
+    cancel_scaling_print(&mut h);
+    let doc = h.state().session.get(id).unwrap();
+    assert!(!doc.dirty);
+    assert_eq!((doc.can_undo(), doc.can_redo()), (None, None));
+    assert_ne!(doc.bytes, before, "only the explicit replacement changed the source");
+}
+
+#[test]
+fn print_scaling_manual_handling_and_sizing_are_remembered_separately() {
+    use pdfcraft_engine::print::SizeMode;
+    use pdfcraft_ui_egui::PrintHandling;
+    let mut h = scaling_harness();
+    h.state_mut().print_draft.handling = PrintHandling::Multiple;
+    h.state_mut().print_draft.size = SizeMode::Shrink;
+    open_scaling_print(&mut h);
+    assert_eq!((h.state().print_draft.handling, h.state().print_draft.size), (PrintHandling::Size, SizeMode::Actual));
+    h.get_by_label("Poster").click();
+    h.run_steps(2);
+    cancel_scaling_print(&mut h);
+    h.get_by_label("default.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    assert_eq!((h.state().print_draft.handling, h.state().print_draft.size), (PrintHandling::Poster, SizeMode::Shrink));
+    cancel_scaling_print(&mut h);
+    h.get_by_label("none.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    // Clicking an already selected seeded radio is still an explicit manual choice.
+    h.get_by_label("Actual size").click();
+    h.run_steps(2);
+    cancel_scaling_print(&mut h);
+    h.get_by_label("default.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    assert_eq!((h.state().print_draft.handling, h.state().print_draft.size), (PrintHandling::Poster, SizeMode::Actual));
+    cancel_scaling_print(&mut h);
+    h.get_by_label("none.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    h.get_by_label("Size").click();
+    h.run_steps(2);
+    h.get_by_label("Custom scale:").click();
+    h.run_steps(2);
+    h.state_mut().print_draft.custom_scale = 73.0;
+    cancel_scaling_print(&mut h);
+    h.get_by_label("default.pdf").click();
+    h.run_steps(2);
+    open_scaling_print(&mut h);
+    assert_eq!(h.state().print_draft.handling, PrintHandling::Size);
+    assert_eq!(h.state().print_draft.settings(1, &[]).unwrap().layout, pdfcraft_engine::print::Layout::Size(SizeMode::Custom(73.0)));
+}
