+#[test]
+fn print_scaling_manual_fit_changes_saved_print_placement() {
+    use pdfcraft_engine::print::Orientation;
+    let mut h = scaling_harness();
+    let id = h.state().views[0].id;
+    let before = h.state().session.get(id).unwrap().bytes.clone();
+    open_scaling_print(&mut h);
+    h.get_by_label("Fit").click();
+    h.run_steps(2);
+    let out = std::env::temp_dir().join(format!("pdfcraft-print-scaling-fit-{}.pdf", std::process::id()));
+    h.state_mut().print_draft.orientation = Orientation::Portrait;
+    h.state_mut().print_draft.printer = None;
+    h.state_mut().save_override = Some(out.to_string_lossy().into_owned());
+    h.run_steps(1);
+    h.get_by_label("Save as PDF").click();
+    h.run_steps(3);
+    assert_eq!(h.state().dialog, None);
+    assert_printed_placement(printed_placement(std::fs::read(&out).unwrap()), [2.52, 0.0, 0.0, 2.52, 54.0, 18.0]);
+    let doc = h.state().session.get(id).unwrap();
+    assert_eq!(doc.bytes, before);
+    assert!(!doc.dirty);
+    assert_eq!((doc.can_undo(), doc.can_redo()), (None, None));
+    let _ = std::fs::remove_file(out);
+}
