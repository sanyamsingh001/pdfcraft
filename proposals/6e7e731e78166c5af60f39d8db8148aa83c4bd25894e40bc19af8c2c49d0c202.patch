+fn print_scaling_fixture(scaling: Option<&str>, indirect: bool) -> Vec<u8> {
+    let entry = scaling.map(|name| if indirect { "/PrintScaling 6 0 R".into() } else { format!("/PrintScaling /{name}") }).unwrap_or_default();
+    let preferences =
+        scaling.map(|_| if indirect { "/ViewerPreferences 5 0 R".into() } else { format!("/ViewerPreferences << {entry} >>") }).unwrap_or_default();
