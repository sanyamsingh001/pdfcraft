+#[test]
+fn print_scaling_omitted_layout_uses_document_default_and_explicit_layout_wins() {
+    let dir = workdir("print-scaling");
+    let mut a = auto(&dir);
+    for (index, scaling, indirect, default) in [
+        (0, Some("None"), true, [1.0, 0.0, 0.0, 1.0, 206.0, 246.0]),
+        (1, Some("AppDefault"), false, [2.52, 0.0, 0.0, 2.52, 54.0, 18.0]),
+        (2, None, false, [2.52, 0.0, 0.0, 2.52, 54.0, 18.0]),
+        (3, Some("Unknown"), true, [2.52, 0.0, 0.0, 2.52, 54.0, 18.0]),
+    ] {
+        let name = format!("preset-{index}.pdf");
+        let bytes = print_scaling_fixture(scaling, indirect);
+        std::fs::write(dir.join(&name), &bytes).unwrap();
+        let doc = ok(&mut a, "doc_open", json!({"path": name}))["doc"].as_u64().unwrap();
+        let before = ok(&mut a, "doc_info", json!({"doc": doc}))["document"].clone();
+        // Optional arguments treat null as absent, so both use the document's default.
+        for (layout, expected) in [
+            (None, default),
+            (Some(Value::Null), default),
+            (Some(json!("actual")), [1.0, 0.0, 0.0, 1.0, 206.0, 246.0]),
+            (Some(json!("fit")), [2.52, 0.0, 0.0, 2.52, 54.0, 18.0]),
+        ] {
+            let mut args = json!({"doc": doc, "paper": "Letter", "orientation": "portrait", "path": "printed.pdf"});
+            if let Some(layout) = layout {
+                args["layout"] = layout;
+            }
+            ok(&mut a, "doc_print", args);
+            assert_printed_placement(printed_placement(std::fs::read(dir.join("printed.pdf")).unwrap()), expected);
+        }
+        for layout in [json!(""), json!("unknown")] {
+            assert!(matches!(a.call("doc_print", &json!({"doc": doc, "layout": layout, "path": "refused.pdf"})), Err(ToolError::InvalidArgs(_))));
+        }
+        assert!(!dir.join("refused.pdf").exists());
+        assert_eq!(ok(&mut a, "doc_info", json!({"doc": doc}))["document"], before);
+        assert_eq!(std::fs::read(dir.join(name)).unwrap(), bytes, "reading print defaults does not rewrite the source");
+    }
+}
