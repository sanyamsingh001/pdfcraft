+fn printed_placement(bytes: Vec<u8>) -> [f64; 6] {
+    let doc = pdfcraft_cos::Document::open(std::sync::Arc::new(bytes)).unwrap();
+    let pages = pdfcraft_model::pages(&doc);
+    assert_eq!(pages.len(), 1);
+    let contents = doc.resolve(pages[0].dict.get(b"Contents").unwrap());
+    let pdfcraft_cos::Object::Stream(stream) = contents.as_ref() else { panic!("print sheet content stream") };
+    let text = String::from_utf8(stream.decoded().unwrap()).unwrap();
+    let words: Vec<_> = text.split_whitespace().collect();
+    let matrix = words.windows(7).find(|words| words[6] == "cm").unwrap();
+    std::array::from_fn(|i| matrix[i].parse().unwrap())
+}
