+/// Advance the live native open worker until this fixture is admitted, without retrying input.
+fn wait_for_open_document(h: &mut Harness<'static, PdfCraftApp>, name: &str, allow_initial_password_prompt: bool) {
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    loop {
+        let app = h.state();
+        let opened = app.active.and_then(|index| app.views.get(index)).and_then(|view| app.session.get(view.id));
+        if opened.is_some_and(|doc| doc.name == name && doc.path.is_none()) && app.password_prompt.is_none() {
+            return;
+        }
+        assert!(
+            app.password_prompt
+                .as_ref()
+                .is_none_or(|prompt| { allow_initial_password_prompt && prompt.name == name && prompt.path.is_none() && prompt.error.is_none() }),
+            "unexpected password prompt or rejected password for {name}"
+        );
+        assert!(
+            app.toast.as_ref().is_none_or(|toast| !toast.0.starts_with("Couldn't open") && !toast.0.starts_with("Couldn't read")),
+            "fixture failed to open: {:?}",
+            app.toast
+        );
+        assert!(
+            std::time::Instant::now() < deadline,
+            "{name} did not become active: active {:?}, tabs {}, password prompt {}, toast {:?}",
+            app.active,
+            app.views.len(),
+            app.password_prompt.is_some(),
+            app.toast
+        );
+        h.run_steps(1);
+        std::thread::yield_now();
+    }
+}
+
 fn organize(pages: usize) -> Harness<'static, PdfCraftApp> {
     harness(pages, |app| app.set_option("organize", "on").unwrap())
 }
